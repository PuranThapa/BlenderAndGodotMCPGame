; Engine configuration file.
; Paper Boy: Morning Delivery

config_version=5

[application]

config/name="Paper Boy: Morning Delivery"
config/description="Open-world bicycle newspaper delivery game."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[input]

pedal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
steer_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
steer_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":86)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
toggle_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":80)]
}
bell={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
respawn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
toggle_help={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="npcs"
3d_physics/layer_5="triggers"

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
